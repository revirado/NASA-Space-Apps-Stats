// FILE: prisma/schema.prisma
// Modelo de datos de la sección 6 del brief técnico, adaptado a SQLite
// (sandbox). En producción (Neon/Postgres) solo cambia:
//   provider = "postgresql" y capturedAt DateTime @db.Timestamptz
// La llave natural es captured_at (no hay ids autoincrementales): dos
// reconstrucciones desde los JSON crudos dan filas idénticas (sección 9).
// La DB es descartable y reconstruible; los JSON crudos son la fuente de verdad.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Una captura: archivos crudos + fecha indicada por el autor (D15).
model Snapshot {
  capturedAt         String   @id // ISO 8601 UTC, la que ingresa el autor
  note               String?
  declaredTotal      Int // totalCount de la plataforma
  totalRegistrations Int? // cachedEventRegistrations (opcional por snapshot, D2)
  totalLocalEvents   Int? // cachedLocalEvents
  teams              Int? // cachedTeams
  ingestedAt         DateTime @default(now()) // nunca se muestra como "última actualización" (D16)

  files SnapshotFile[]
  stats EventStat[]
}

/// Un archivo crudo de una captura, con sha256 para idempotencia (paso 9, D3-D4).
model SnapshotFile {
  sha256        String  @id
  capturedAt    String
  originalName  String
  offsetStart   Int
  offsetEnd     Int
  hasEventBlock Boolean

  snapshot Snapshot @relation(fields: [capturedAt], references: [capturedAt])

  @@index([capturedAt])
}

/// Desnormalizado a propósito: cada snapshot guarda todos los atributos de sus
/// locaciones (sección 6). ~600 filas por snapshot.
model EventStat {
  capturedAt       String
  externalId       String // opaco, tal cual llega (D5)
  title            String
  country          String // texto libre en inglés (D9)
  iso2             String? // desde countryMap (D9); null = sin mapeo
  lat              Float // invertidas desde GeoJSON [lng,lat] (D6)
  lng              Float
  registrations    Int // cachedRegistrations tal cual (D7)
  eventType        String // In-Person | Virtual | Virtual & In-Person (D11)
  registrationOpen Boolean
  isWaitlist       Boolean
  isUniversal      Boolean // country === 'Anywhere in the World' (D8)
  url              String

  snapshot Snapshot @relation(fields: [capturedAt], references: [capturedAt])

  @@id([capturedAt, externalId])
  @@index([capturedAt, country])
}

/// Único dato escrito a mano (D9): país de la plataforma → ISO2.
/// Se versiona en el repositorio (src/domain/countryMap.ts) y se sincroniza.
model CountryMap {
  country     String   @id
  iso2        String?
  polygonName String?
  updatedAt   DateTime @updatedAt
}

/// Detección de un esquema que el código no espera (secciones 2 y 13).
model SchemaVersion {
  version   Int      @id
  appliedAt DateTime @default(now())
}
